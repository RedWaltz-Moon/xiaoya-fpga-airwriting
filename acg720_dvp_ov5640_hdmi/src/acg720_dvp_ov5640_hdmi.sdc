create_clock -name clk50M -period 20.000 [get_ports {clk50M}]
create_clock -name COMS_PCLK -period 20.000 [get_ports {COMS_PCLK}]
create_generated_clock -name ddr_ui_clk -source [get_ports {clk50M}] -master_clock clk50M -divide_by 1 -multiply_by 1 [get_pins {u_ddr3/gw3_top/u_ddr_phy_top/fclkdiv/CLKOUT}]
create_generated_clock -name hdmi_pixel_clk -source [get_ports {clk50M}] -master_clock clk50M -divide_by 200 -multiply_by 297 [get_pins {u_hdmi_clkdiv/CLKOUT}]
set_clock_groups -asynchronous -group [get_clocks {clk50M}] -group [get_clocks {COMS_PCLK}]
set_clock_groups -asynchronous -group [get_clocks {clk50M}] -group [get_clocks {ddr_ui_clk}]
set_clock_groups -asynchronous -group [get_clocks {clk50M}] -group [get_clocks {hdmi_pixel_clk}]
set_clock_groups -asynchronous -group [get_clocks {COMS_PCLK}] -group [get_clocks {ddr_ui_clk}]
set_clock_groups -asynchronous -group [get_clocks {COMS_PCLK}] -group [get_clocks {hdmi_pixel_clk}]
set_clock_groups -asynchronous -group [get_clocks {ddr_ui_clk}] -group [get_clocks {hdmi_pixel_clk}]
set_false_path -to [get_pins {u_hdmi_clkdiv/RESETN}]
set_false_path -to [get_pins {hdmi_reset_sync_0_s0/CLEAR}]
set_false_path -to [get_pins {hdmi_reset_sync_1_s0/CLEAR}]
set_false_path -to [get_pins {u_hdmi_tmds_tx/u_serializer/u_oser_lane0/RESET}]
set_false_path -to [get_pins {u_hdmi_tmds_tx/u_serializer/u_oser_lane1/RESET}]
set_false_path -to [get_pins {u_hdmi_tmds_tx/u_serializer/u_oser_lane2/RESET}]
set_false_path -to [get_pins {u_hdmi_tmds_tx/u_serializer/u_oser_lane3/RESET}]
