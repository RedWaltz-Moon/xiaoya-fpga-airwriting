module result_audio_event (
  clk50M_d,
  n1432_7,
  recognition_result_valid,
  hdmi_pixel_clk,
  n1109_6,
  playing,
  audio_play_start
)
;
input clk50M_d;
input n1432_7;
input recognition_result_valid;
input hdmi_pixel_clk;
input n1109_6;
input playing;
output audio_play_start;
wire n69_3;
wire n50_15;
wire pending_count_1_7;
wire n49_21;
wire n48_21;
wire n47_25;
