    .RESET(n813_6),
    .ADA({pixel_x_filter_d[10:0],GND,GND,GND}),
    .ADB({pixel_x_d[10:0],GND,GND,GND}),
    .DI({GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,GND,foreground_hand_filter_d,line_history_q[1]}),
    .BLKSELA({GND,GND,GND}),
