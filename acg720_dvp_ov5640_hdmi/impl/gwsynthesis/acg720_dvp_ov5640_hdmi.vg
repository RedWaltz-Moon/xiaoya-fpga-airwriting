module Gowin_PLL_MOD (
  clk50M_d,
  pll_rst,
  pll_stop,
  icpsel,
  lpfres,
  pll_lock,
  clk200M
)
;
input clk50M_d;
input pll_rst;
input pll_stop;
input [0:0] icpsel;
input [2:0] lpfres;
output pll_lock;
output clk200M;
wire pll_clkout0_unused;
wire pll_clkout1_unused;
wire clkout3;
wire clkout4;
wire clkout5;
wire clkout6;
wire clkfbout;
wire VCC;
wire GND;
  PLL PLL_inst (
    .LOCK(pll_lock),
    .CLKOUT0(pll_clkout0_unused),
    .CLKOUT1(pll_clkout1_unused),
    .CLKOUT2(clk200M),
    .CLKOUT3(clkout3),
    .CLKOUT4(clkout4),
    .CLKOUT5(clkout5),
    .CLKOUT6(clkout6),
    .CLKFBOUT(clkfbout),
    .CLKIN(clk50M_d),
    .CLKFB(GND),
    .RESET(pll_rst),
    .PLLPWD(GND),
    .RESET_I(GND),
    .RESET_O(GND),
    .FBDSEL({GND,GND,GND,GND,GND,GND}),
    .IDSEL({GND,GND,GND,GND,GND,GND}),
    .MDSEL({GND,GND,GND,GND,GND,GND,GND}),
    .MDSEL_FRAC({GND,GND,GND}),
    .ODSEL0({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL0_FRAC({GND,GND,GND}),
    .ODSEL1({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL2({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL3({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL4({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL5({GND,GND,GND,GND,GND,GND,GND}),
    .ODSEL6({GND,GND,GND,GND,GND,GND,GND}),
    .DT0({GND,GND,GND,GND}),
    .DT1({GND,GND,GND,GND}),
    .DT2({GND,GND,GND,GND}),
    .DT3({GND,GND,GND,GND}),
