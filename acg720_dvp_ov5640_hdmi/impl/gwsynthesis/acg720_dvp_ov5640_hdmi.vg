    .clk50M_d(clk50M_d),
    .pll_rst(pll_rst),
    .pll_stop(pll_stop),
    .icpsel(icpsel[0]),
    .lpfres(lpfres[2:0]),
    .pll_lock(pll_lock),
    .clk200M(clk200M)
);
  PLL_INIT u_pll_init (
    .clk50M_d(clk50M_d),
    .n7_6(n7_6),
    .pll_lock(pll_lock),
    .reset_sync(reset_sync[1]),
    .pll_rst(pll_rst),
    .lpfres(lpfres[2:0]),
    .icpsel(icpsel[0]),
    .led_d(led_d[0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* Gowin_PLL */
